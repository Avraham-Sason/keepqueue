ly_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "PRD.md", "source_location": "Section 6 Non-Functional Requirements", "weight": 1.0}, {"source": "prd_queue_motif_theme", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 7 Design Guidelines", "weight": 1.0}], "hyperedges": [{"id": "no_show_reduction_strategy", "label": "No-Show Reduction Strategy", "nodes": ["prd_automatic_reminders_and_confirmations", "prd_smart_waiting_list", "prd_problematic_customer_handling", "prd_real_time_reports_and_stats"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRD.md"}]}