{"nodes": [{"id": "prd_keepqueue", "label": "Keepqueue SaaS Appointment Platform", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 1 Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Product exists to let small service businesses manage appointments end-to-end from booking through reminders, centralizing customer, appointment and business management in one platform instead of scattered tools."}, {"id": "prd_business_owners", "label": "Business Owners (Target User)", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 3 Target Users", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoped deliberately to hair salons, beauty clinics, nail studios and aesthetic providers rather than generic scheduling, so the calendar and service model can assume appointment-based personal services."}, {"id": "prd_customers", "label": "Customers (Target User)", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 3 Target Users", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_online_appointment_booking", "label": "24/7 Online Appointment Booking", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-service booking, rescheduling and cancellation is the MVP anchor feature: it removes the phone-call bottleneck for the business owner and is the only flow the public (unauthenticated) user reaches."}, {"id": "prd_smart_digital_calendar", "label": "Smart Digital Calendar", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configurable hours, breaks, holidays and services \u2014 availability is derived from business configuration rather than hand-maintained slot lists."}, {"id": "prd_automatic_reminders_and_confirmations", "label": "Automatic Reminders and Confirmations", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen explicitly to reduce no-shows, which is the primary revenue leak for appointment-based small businesses."}, {"id": "prd_smart_waiting_list", "label": "Smart Waiting List", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns a cancellation into a recovered booking by notifying waiting customers when a slot frees up, so cancelled time is refilled rather than lost."}, {"id": "prd_real_time_reports_and_stats", "label": "Real-Time Reports and Stats", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Booking counts and no-show rate are called out as the reporting objective so owners can see appointments made/cancelled and services sold."}, {"id": "prd_web_client_app", "label": "Web Client App", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_ratings_and_reviews", "label": "Ratings and Reviews", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviews are surfaced on the public business profile, making them a customer-acquisition surface rather than only internal feedback."}, {"id": "prd_problematic_customer_handling", "label": "Problematic Customer Handling", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocking frequent no-shows and alerting the owner is the enforcement half of the no-show strategy: reminders are preventive, blocking is punitive."}, {"id": "prd_business_admin_dashboard", "label": "Business Admin Dashboard", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 5 Core Features #11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles profile, services, customers and bookings management plus a one-click branded public page, so onboarding a business does not require any manual setup work by the vendor."}, {"id": "prd_non_negotiable_tech_stack", "label": "Non-Negotiable Tech Stack", "file_type": "rationale", "source_file": "PRD.md", "source_location": "Section 4 Tech Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firebase (Auth, Firestore, Storage), Tailwind + Origin UI + shadcn UI, and Zustand are fixed up front and marked non-negotiable, removing stack debate and letting the team assume a serverless managed backend with no self-hosted database."}, {"id": "prd_wcag_2_1_aa_compliance", "label": "WCAG 2.1 AA Compliance Requirement", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 6 Non-Functional Requirements", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_lighthouse_score_target", "label": "Lighthouse >= 90 Target", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 6 Non-Functional Requirements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single measurable gate across Performance, Accessibility, Best Practices and SEO, chosen so quality is verified by a tool rather than by review opinion."}, {"id": "prd_mobile_first_responsiveness", "label": "Mobile-First Responsiveness", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 6 Non-Functional Requirements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customers book from phones, so the mobile layout is the design baseline and desktop is the enhancement."}, {"id": "prd_queue_motif_theme", "label": "Minimalistic Queue Motif Theme", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 7 Design Guidelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual identity tied to the product name, with subtle SVG or Lottie animations reserved for transitions and success states so motion signals progress rather than decorating."}, {"id": "prd_three_click_booking_flow", "label": "Three-Click Booking Flow Constraint", "file_type": "rationale", "source_file": "PRD.md", "source_location": "Section 7 Design Guidelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Booking must complete in three clicks or fewer; a hard interaction budget that constrains the public booking UI and forbids multi-step wizards or account creation before booking."}, {"id": "prd_definition_of_done", "label": "Definition of Done", "file_type": "concept", "source_file": "PRD.md", "source_location": "Section 9 Definition of Done", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Done is defined by cross-browser function (Chrome, Safari, Edge, mobile), a passing automated suite, Lighthouse targets, and an end-to-end customer journey \u2014 book, receive reminders, leave reviews, admin sees analytics."}], "edges": [{"source": "prd_business_owners", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 3 Target Users", "weight": 1.0}, {"source": "prd_customers", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 3 Target Users", "weight": 1.0}, {"source": "prd_online_appointment_booking", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 5 Core Features", "weight": 1.0}, {"source": "prd_smart_digital_calendar", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 5 Core Features", "weight": 1.0}, {"source": "prd_business_admin_dashboard", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 5 Core Features", "weight": 1.0}, {"source": "prd_web_client_app", "target": "prd_keepqueue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "Section 5 Core Features", "weight": 1.0}, {"source": "prd_smart_waiting_list", "target": "prd_smart_digital_calendar", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRD.md", "source_location": "Section 5 Core Features #2 and #4", "weight": 1.0}, {"source": "prd_problematic_customer_handling", "target": "prd_automatic_reminders_and_confirmations", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRD.md", "source_location": "Section 5 Core Features #3 and #9", "weight": 1.0}, {"source": "prd_smart_waiting_list", "target": "prd_automatic_reminders_and_confirmations", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "PRD.