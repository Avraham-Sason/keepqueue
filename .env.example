# Copy to .env at the repo root and fill in. Never commit the filled file.

# ---- Client (Next.js, public — inlined into the browser bundle) ----
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=

# ---- Server (Express, secret — Firebase Admin service account) ----
# Names are lower-case because the Admin SDK credential object is built from them verbatim.
PORT=9000
type=service_account
project_id=
private_key_id=
private_key=
client_email=
client_id=
auth_uri=https://accounts.google.com/o/oauth2/auth
token_uri=https://oauth2.googleapis.com/token
auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
client_x509_cert_url=
universe_domain=googleapis.com

# Comma-separated extra origins allowed to call the API (optional).
allowed_origins=
